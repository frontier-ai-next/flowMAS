FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim

WORKDIR /app

RUN uv pip install --system "torch>=2.11" \
    --index-url https://download.pytorch.org/whl/cpu

COPY vendor/gmas ./vendor/gmas
RUN uv pip install --system -e "vendor/gmas[web-search,mcp,selenium]"

COPY packages/gmas-observability ./packages/gmas-observability
RUN uv pip install --system ./packages/gmas-observability

COPY apps/api/pyproject.toml ./apps/api/pyproject.toml
COPY apps/api/backend/ ./apps/api/backend/

RUN uv pip install --system ./apps/api

RUN mkdir -p apps/api/data/agents apps/api/data/graphs apps/api/data/runs

ENV PYTHONPATH=/app/apps/api
ENV GMAS_SRC_PATH=/app/vendor/gmas/src

EXPOSE 8000

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/api/health')"

CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
