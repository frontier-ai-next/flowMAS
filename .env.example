# LLM provider keys (configured in UI → Settings → LLM Providers, or here)
GMAS_API_KEY=
GMAS_API_KEY_FILE=
GMAS_PROVIDER_SECRET_KEY=

# Standalone gMAS observability product
GMAS_OBSERVABILITY_ENABLED=true
GMAS_OBSERVABILITY_ENDPOINT=http://observability:8100
GMAS_OBSERVABILITY_PROJECT=gmas-demo
GMAS_OBSERVABILITY_ENVIRONMENT=development
GMAS_OBSERVABILITY_API_KEY=
GMAS_OBSERVABILITY_CAPTURE_CONTENT=true

# Persistent host directories mounted by Docker Compose.
# Relative paths are resolved from the repository root.
GMAS_DATA_PATH=./.docker-data/api
GMAS_OBSERVABILITY_DATA_PATH=./.docker-data/observability
